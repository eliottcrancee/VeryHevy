{
  "name": "veryhevy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:typecheck": "tsc -b --noEmit",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:audit": "node scripts/audit.mjs",
    "test:regress": "node scripts/regress.mjs",
    "test:perms": "node scripts/check-permissions.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:all": "npm run test:i18n && npm run test:perms && npm run build && node scripts/smoke.mjs && node scripts/audit.mjs && node scripts/regress.mjs && node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "heic2any": "^0.0.4",
    "idb-keyval": "^6.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
